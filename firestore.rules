rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    function role(r) { return userRole() == r; }
    function admin() { return role('admin'); }

    function validVehicle(v) { return v in ['Sedan', 'SUV', 'MPV']; }
    function validPlate(v) { return v is string && v.size() >= 2 && v.size() <= 20; }
    function validCarModel(v) { return v is string && v.size() >= 2 && v.size() <= 60; }
    function validCarColor(v) { return v is string && v.size() >= 2 && v.size() <= 30; }
    function validPhoto(v) { return v is string && v.size() > 100 && v.size() < 300000; }
    function validWhatsApp(v) { return v is string && v.size() >= 8 && v.size() <= 20; }
    function validTripStatus(v) {
      return v in ['AwaitingDriver','Accepted','OnTheWay','ArrivedPickup','PickedUp','ArrivedDestination','DroppedOff','Completed'];
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['customer','driver']
        && (request.resource.data.role != 'driver'
          || (validVehicle(request.resource.data.vehicleType)
            && validCarModel(request.resource.data.carModel)
            && validCarColor(request.resource.data.carColor)
            && validPlate(request.resource.data.plateNumber)
            && validWhatsApp(request.resource.data.whatsappNumber)));

      allow read: if signedIn() && (request.auth.uid == uid || admin());

      allow update: if admin()
        || (signedIn() && request.auth.uid == uid
          && resource.data.role == 'driver'
          && request.resource.data.role == 'driver'
          && validVehicle(request.resource.data.vehicleType)
          && validCarModel(request.resource.data.carModel)
          && validCarColor(request.resource.data.carColor)
          && validPlate(request.resource.data.plateNumber)
          && validWhatsApp(request.resource.data.whatsappNumber)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName','vehicleType','carModel','carColor','languages','plateNumber','whatsappNumber'
          ]));

      allow delete: if admin();
    }

    match /driverPublicProfiles/{uid} {
      allow read: if signedIn() && (role('customer') || role('driver') || admin());

      allow create: if signedIn() && role('driver') && request.auth.uid == uid
        && validVehicle(request.resource.data.vehicleType)
        && validCarModel(request.resource.data.carModel)
        && validCarColor(request.resource.data.carColor)
        && validPlate(request.resource.data.plateNumber)
        && validWhatsApp(request.resource.data.whatsappNumber)
        && validPhoto(request.resource.data.selfieDataUrl)
        && validPhoto(request.resource.data.carPhotoDataUrl);

      allow update: if admin()
        || (signedIn() && role('driver') && request.auth.uid == uid
          && validVehicle(request.resource.data.vehicleType)
          && validCarModel(request.resource.data.carModel)
          && validCarColor(request.resource.data.carColor)
          && validPlate(request.resource.data.plateNumber)
          && validWhatsApp(request.resource.data.whatsappNumber)
          && validPhoto(request.resource.data.selfieDataUrl)
          && validPhoto(request.resource.data.carPhotoDataUrl)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName','vehicleType','carModel','carColor','plateNumber','whatsappNumber',
            'languages','selfieDataUrl','carPhotoDataUrl','updatedAt'
          ]));

      allow delete: if admin();
    }

    match /bookings/{id} {
      allow create: if signedIn() && role('customer')
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'Available'
        && validVehicle(request.resource.data.vehicleType);

      allow read: if admin()
        || (signedIn() && role('customer') && resource.data.customerUid == request.auth.uid)
        || (signedIn() && role('driver') && resource.data.status == 'Available')
        || (signedIn() && role('driver') && resource.data.driverUid == request.auth.uid);

      allow update: if admin()

        // Driver accepts an available booking.
        || (signedIn() && role('driver')
          && resource.data.status == 'Available'
          && request.resource.data.status == 'Accepted'
          && request.resource.data.driverUid == request.auth.uid
          && request.resource.data.vehicleType == resource.data.vehicleType
          && request.resource.data.vehicleType == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vehicleType
          && request.resource.data.driverPlateNumber == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plateNumber
          && request.resource.data.tripStatus == 'Accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','tripStatus','tripStatusUpdatedAt','driver','driverUid','driverWhatsApp',
            'driverVehicleType','driverCarModel','driverCarColor','driverPlateNumber','acceptedAt'
          ]))

        // Driver updates live trip status.
        // Keep this rule deliberately simple for the RM0 MVP:
        // the existing booking owner may only move the trip one step forward.
        || (signedIn()
          && resource.data.driverUid == request.auth.uid
          && resource.data.status == 'Accepted'
          && request.resource.data.driverUid == resource.data.driverUid
          && (
            (resource.data.tripStatus == 'Accepted' && request.resource.data.tripStatus == 'OnTheWay')
            || (resource.data.tripStatus == 'OnTheWay' && request.resource.data.tripStatus == 'ArrivedPickup')
            || (resource.data.tripStatus == 'ArrivedPickup' && request.resource.data.tripStatus == 'PickedUp')
            || (resource.data.tripStatus == 'PickedUp' && request.resource.data.tripStatus == 'ArrivedDestination')
            || (resource.data.tripStatus == 'ArrivedDestination' && request.resource.data.tripStatus == 'DroppedOff')
            || (resource.data.tripStatus == 'DroppedOff' && request.resource.data.tripStatus == 'Completed')
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'tripStatus',
            'tripStatusUpdatedAt',
            'onTheWayAt',
            'arrivedPickupAt',
            'pickedUpAt',
            'arrivedDestinationAt',
            'droppedOffAt',
            'completedAt',
            'status'
          ])
          && (
            (request.resource.data.tripStatus != 'Completed'
              && request.resource.data.status == resource.data.status)
            || (request.resource.data.tripStatus == 'Completed'
              && request.resource.data.status == 'Completed')
          ))

      allow delete: if admin();
    }

    match /driverSchedules/{id} {
      allow create: if signedIn() && role('driver')
        && request.auth.uid == request.resource.data.driverUid;

      allow read: if signedIn()
        && (admin() || (role('driver') && resource.data.driverUid == request.auth.uid));

      allow update, delete: if signedIn()
        && (admin() || (role('driver') && resource.data.driverUid == request.auth.uid));
    }
  }
}
